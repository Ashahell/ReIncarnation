AUTODOC midi.doc — MIDI learn map + clock/MMC + flood + backend (Task 13/14).
Header: midi_io/midi.h. Flood cap RI_MIDI_MAX_PER_BUFFER 64 (P-19 OPEN
value, soak-gated). Status codes RI_MIDI_OK / RI_MIDI_NO_DEVICE /
RI_MIDI_TIMEOUT. AROS bridge: midi_io/camd_backend.c
(ri_camd_open / ri_camd_close / ri_camd_status / ri_camd_unplug /
ri_camd_pump — AROS-only, compile-checked; live device open deferred).

void midi_learn_init(struct RIMidiLearn *m)
  Clear the CC map (all -1). No result.

void midi_learn(struct RIMidiLearn *m, uint32_t cc, uint32_t ctl)
  Learn CC->control (cc < 128, ctl <= 0xffff; else ignored). No result.

int32_t midi_cc_lookup(const struct RIMidiLearn *m, uint32_t cc)
  Lookup. Result: control id or -1 (unmapped fails closed).

uint32_t midi_note_step(uint8_t note)
  Note to step. Result: note % 16.

uint8_t midi_note_accent(uint8_t vel)
  Velocity accent. Result: 1 if vel >= 64 else 0.

int midi_mmc_cmd(const void *buf, uint32_t n)
  MMC sysex (F0 7F dev 06 cmd F7). Result: 1 play, 0 stop, -1 not-a-command.

void midi_clock_init(struct RIMidiClock *c)
void midi_clock_advance(struct RIMidiClock *c)
uint32_t midi_clock_drift(const struct RIMidiClock *c, uint32_t expect)
  24-tick clock + drift (|ticks - expect|).

void midi_flood_init(struct RIFlood *f)
void midi_flood_push(struct RIFlood *f, uint8_t b)
  Flood buffer; beyond 64 oldest-first shed, counted in dropped.
uint32_t midi_flood_len(const struct RIFlood *f)
uint8_t midi_flood_get(const struct RIFlood *f, uint32_t i)

int midi_backend_status(void)
void midi_backend_unplug(void)
void midi_backend_replug(void)
int midi_transport_alive(void)
  Backend state machine; transport always alive (1).
